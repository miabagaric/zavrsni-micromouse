<?xml version="1.0"?>
<robot name="micromouse" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====== VARIJABLE (SI: metri, kg; x = naprijed) ====== -->
  <!-- gabarit: sirina 85mm, duljina ~103mm, ploca 2mm -->
  <xacro:property name="board_thick"  value="0.002"/>
  <xacro:property name="board_mass"   value="0.300"/>

  <xacro:property name="rear_len"     value="0.061"/>   <!-- straznji pravokutnik: duljina x -->
  <xacro:property name="rear_wid"     value="0.085"/>   <!-- sirina y -->
  <xacro:property name="rear_cx"      value="0.005"/>   <!-- centar straznjeg dijela (x) -->

  <xacro:property name="nose_radius"  value="0.0425"/>  <!-- prednji krug Ă85 -->
  <xacro:property name="nose_cx"      value="0.035"/>   <!-- centar kruga naprijed (x) -->

  <xacro:property name="wheel_radius" value="0.010"/>   <!-- Ă20mm -->
  <xacro:property name="wheel_width"  value="0.010"/>
  <xacro:property name="wheel_mass"   value="0.010"/>
  <xacro:property name="wheel_sep"    value="0.080"/>   <!-- track 80mm -->

  <xacro:property name="caster_radius" value="0.005"/>
  <xacro:property name="caster_cx"     value="0.060"/>  <!-- prednji oslonac 60mm naprijed -->

  <!-- IR senzori (ray) -->
  <xacro:property name="ir_range_min"  value="0.001"/>
  <xacro:property name="ir_range_max"  value="0.20"/>
  <xacro:property name="ir_update"     value="30"/>

  <!-- ====== MATERIJALI (RViz) ====== -->
  <material name="pcb_green"><color rgba="0.10 0.45 0.20 1.0"/></material>
  <material name="rubber"><color   rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="gold"><color     rgba="0.85 0.65 0.13 1.0"/></material>
  <material name="chip"><color     rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="batt"><color     rgba="0.15 0.20 0.55 1.0"/></material>
  <material name="ir_red"><color   rgba="0.85 0.10 0.10 1.0"/></material>

  <!-- ====== MAKROI: INERCIJA ====== -->
  <xacro:macro name="wheel_inertia" params="m r w">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r+w*w)}" ixy="0.0" ixz="0.0"
               iyy="${0.5*m*r*r}"                iyz="0.0"
               izz="${(1.0/12.0)*m*(3*r*r+w*w)}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${0.4*m*r*r}" ixy="0.0" ixz="0.0"
               iyy="${0.4*m*r*r}" iyz="0.0" izz="${0.4*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ====== BAZA ====== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <!-- obris: straznji pravokutnik + prednji krug (union) -->
    <visual>
      <origin xyz="${rear_cx} 0 0" rpy="0 0 0"/>
      <geometry><box size="${rear_len} ${rear_wid} ${board_thick}"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <visual>
      <origin xyz="${nose_cx} 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${nose_radius}" length="${board_thick}"/></geometry>
      <material name="pcb_green"/>
    </visual>

    <!-- collision: isti zaobljeni obris -->
    <collision>
      <origin xyz="${rear_cx} 0 0" rpy="0 0 0"/>
      <geometry><box size="${rear_len} ${rear_wid} ${board_thick}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${nose_cx} 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${nose_radius}" length="${board_thick}"/></geometry>
    </collision>

    <!-- masa 0.3kg, teziste blago naprijed (x=+0.015) za stabilan tronozac -->
    <inertial>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <mass value="${board_mass}"/>
      <inertia ixx="0.0001807" ixy="0.0" ixz="0.0"
               iyy="0.0002653" iyz="0.0" izz="0.0004459"/>
    </inertial>

    <!-- kozmetika (samo visual) -->
    <visual>  <!-- lijevi motor -->
      <origin xyz="0 0.028 0.003" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.006" length="0.016"/></geometry>
      <material name="gold"/>
    </visual>
    <visual>  <!-- desni motor -->
      <origin xyz="0 -0.028 0.003" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.006" length="0.016"/></geometry>
      <material name="gold"/>
    </visual>
    <visual>  <!-- mikrokontroler -->
      <origin xyz="0.010 0 0.003" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.003"/></geometry>
      <material name="chip"/>
    </visual>
    <visual>  <!-- baterija straga -->
      <origin xyz="-0.014 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.024 0.020 0.008"/></geometry>
      <material name="batt"/>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ====== KOTACI ====== -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" w="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 ${y_reflect*wheel_sep/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- ====== PREDNJI OSLONAC (bez trenja) ====== -->
  <link name="front_caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <xacro:sphere_inertia m="0.005" r="${caster_radius}"/>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_caster"/>
    <origin xyz="${caster_cx} 0 ${-(wheel_radius-caster_radius)}" rpy="0 0 0"/>
  </joint>

  <!-- ====== IR SENZORI (okviri; ray senzor tagovi dolaze u 1b, izlaz u metrima) ====== -->
  <xacro:macro name="ir_mount" params="name x y yaw">
    <link name="${name}_link">
      <visual>
        <geometry><box size="0.004 0.006 0.004"/></geometry>
        <material name="ir_red"/>
      </visual>
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="${x} ${y} 0.002" rpy="0 0 ${yaw}"/>
    </joint>

    <!-- IR kao jednozrakalni gpu_lidar; zraka gleda uzduz x-osi okvira -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <update_rate>${ir_update}</update_rate>
        <topic>${name}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range>
            <min>${ir_range_min}</min>
            <max>${ir_range_max}</max>
            <resolution>0.001</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:ir_mount name="ir_left"       x="0.035"  y="0.042"  yaw="1.5708"/>
  <xacro:ir_mount name="ir_left_diag"  x="0.065"  y="0.030"  yaw="0.7854"/>
  <xacro:ir_mount name="ir_front"      x="0.076"  y="0.0"    yaw="0.0"/>
  <xacro:ir_mount name="ir_right_diag" x="0.065"  y="-0.030" yaw="-0.7854"/>
  <xacro:ir_mount name="ir_right"      x="0.035"  y="-0.042" yaw="-1.5708"/>

  <!-- ====== GAZEBO: boje + trenje ====== -->
  <gazebo reference="base_link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!-- ====== GAZEBO HARMONIC: DiffDrive + JointState ====== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
